# 本地开发可以不填写，系统会写入本地 data/*.json。
# 部署到 Streamlit Community Cloud 后，为实现持久化写入 GitHub，请配置以下 Secrets。

GITHUB_OWNER = "your-github-name"
GITHUB_REPO = "graphite-customer-tracker"
GITHUB_TOKEN = "github_pat_xxx"
GITHUB_DATA_BRANCH = "main"

# 推荐正式使用时把数据放到单独分支，例如 crm-data，减少主分支频繁部署。
# GITHUB_DATA_BRANCH = "crm-data"
